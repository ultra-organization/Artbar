{
  "name": "artbar-tokyo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "normalize:logos": "node scripts/normalize-partner-logos.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:acquisition && npm run check:docs && npm run check:seo && npm run check:security && npm run check:performance && npm run check:published-content && npm run check:copy-system && npm run check:responsive-display && npm run check:location-booking && npm run build",
    "check:location-booking": "tsx scripts/location-booking-smoke-check.ts",
    "check:seo": "tsx scripts/seo-smoke-check.ts",
    "check:performance": "tsx scripts/performance-smoke-check.ts",
    "check:security": "tsx scripts/security-smoke-check.ts",
    "check:docs": "tsx scripts/docs-smoke-check.ts",
    "check:copy-system": "tsx scripts/copy-system-smoke-check.ts",
    "check:published-content": "tsx scripts/published-content-check.ts",
    "check:responsive-display": "tsx scripts/responsive-display-smoke-check.ts",
    "generate:images": "tsx scripts/generate-site-images.ts",
    "generate:images:dry": "tsx scripts/generate-site-images.ts --dry-run",
    "generate:images:revision": "tsx scripts/generate-site-images.ts --needs-revision",
    "generate:images:theme-pages": "tsx scripts/generate-site-images.ts --theme-pages",
    "test:acquisition": "tsx --test scripts/painta-acquisition.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@next/third-parties": "^15.5.18",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "budoux": "^0.8.2",
    "lucide-react": "^0.554.0",
    "next": "^15.5.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.12.2",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.14"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.2"
  }
}
